# api = fala com o backend. qualquer outro valor fica local/vazio.
VITE_DATA_MODE=api

# Vazio: o Vite encaminha /api para o backend local.
# Ngrok ou produção: cole a URL pública, sem barra no final.
# VITE_API_BASE_URL=https://xxxx.ngrok-free.dev
VITE_API_BASE_URL=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Se a base estiver vazia e o backend não for localhost:8000,
# suba o Vite com SAST_API_PROXY=https://xxxx.ngrok-free.dev
